8.3)Call Stored Procedures

#Создание и вызов такой функции:

CREATE PROCEDURE test_proc()
LANGUAGE SQL
AS $$
    SELECT * FROM users;
$$;

CALL test_proc();




CREATE PROCEDURE add_user(name TEXT)
LANGUAGE SQL
AS $$
    INSERT INTO users(name) VALUES(name);
$$;

CALL add_user('John');


